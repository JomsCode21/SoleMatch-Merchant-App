<div
  id="solematch-discount-{{ product.id }}"
  class="solematch-discount"
  data-product-id="{{ product.id }}"
>
  <div class="solematch-discount__loading">
    Checking for available offers...
  </div>
</div>

<script>
  (() => {
    const container = document.getElementById(
      "solematch-discount-{{ product.id }}"
    );

    if (!container) return;

    const productId = container.dataset.productId;

    fetch(`/apps/solematch-discount?product_id=${productId}`)
      .then((response) => response.json())
      .then((data) => {
        if (!data.success || !data.discount) {
          container.remove();
          return;
        }

        const discount = data.discount;

        container.innerHTML = `
          <div class="solematch-discount__content">
            <div class="solematch-discount__heading">
              🎉 ${discount.percentage}% OFF THIS PRODUCT
            </div>

            <div class="solematch-discount__details">
              Use code
              <strong>${discount.code}</strong>
              ${
                discount.expiresAt
                  ? `<span class="solematch-discount__expires">
                      · Expires ${new Date(discount.expiresAt).toLocaleDateString()}
                    </span>`
                  : ""
              }
            </div>

            <div class="solematch-discount__actions">
              <button
                type="button"
                class="solematch-discount__copy"
              >
                Copy code
              </button>

              <a
                href="/discount/${discount.code}"
                class="solematch-discount__apply"
              >
                Apply
              </a>
            </div>
          </div>
        `;

        const copyButton = container.querySelector(
          ".solematch-discount__copy"
        );

        copyButton.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(discount.code);

            copyButton.textContent = "Copied!";

            setTimeout(() => {
              copyButton.textContent = "Copy code";
            }, 2000);
          } catch {
            copyButton.textContent = "Copy failed";

            setTimeout(() => {
              copyButton.textContent = "Copy code";
            }, 2000);
          }
        });
      })
      .catch(() => {
        container.remove();
      });
  })();
</script>

<style>
  .solematch-discount {
    margin: 10px 0 0;
    padding: 12px 14px;
    border: 1px solid #e1e3e5;
    border-radius: 8px;
    background: #f6fff9;
  }

  .solematch-discount__loading {
    font-size: 13px;
    color: #6d7175;
  }

  .solematch-discount__heading {
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 4px;
  }

  .solematch-discount__details {
    font-size: 13px;
    line-height: 1.4;
    color: #555;
    margin-bottom: 9px;
  }

  .solematch-discount__details strong {
    color: #222;
    font-weight: 700;
    letter-spacing: 0.2px;
  }

  .solematch-discount__expires {
    color: #6d7175;
  }

  .solematch-discount__actions {
    display: flex;
    gap: 6px;
    align-items: center;
  }

  .solematch-discount__copy,
  .solematch-discount__apply {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    padding: 5px 10px;
    border-radius: 5px;
    border: 1px solid #222;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    text-decoration: none;
    box-sizing: border-box;
  }

  .solematch-discount__copy {
    background: transparent;
    color: #222;
  }

  .solematch-discount__apply {
    background: #222;
    color: #fff;
  }

  .solematch-discount__copy:hover {
    background: #f1f1f1;
  }

  .solematch-discount__apply:hover {
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    .solematch-discount {
      margin-top: 8px;
      padding: 11px 12px;
    }

    .solematch-discount__heading {
      font-size: 13px;
    }

    .solematch-discount__details {
      font-size: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "SoleMatch Discount",
  "target": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "autofill": true
    }
  ]
}
{% endschema %}
